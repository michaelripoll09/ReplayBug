# ReplayBug local development environment.
# Copy to .env before starting: `cp .env.example .env` (PowerShell: `Copy-Item .env.example .env`).
# All values below are safe local placeholders. Never commit real secrets.

# --- Application URLs ---
# Public URL of the Next.js dashboard (apps/web).
REPLAYBUG_WEB_URL=http://localhost:3000
# Public URL of the Fastify API (apps/api).
REPLAYBUG_API_URL=http://localhost:4001
# URL of the demo app (apps/demo).
REPLAYBUG_DEMO_URL=http://localhost:5173

# --- Runtime ports (documented to avoid clashes) ---
# web: 3000, api: 4001, demo: 5173
REPLAYBUG_WEB_PORT=3000
REPLAYBUG_API_PORT=4001
REPLAYBUG_DEMO_PORT=5173

# --- Environment ---
# One of: development | test | production
NODE_ENV=development
REPLAYBUG_ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL ---
# Local Postgres connection used by apps/api, apps/worker and packages/db.
REPLAYBUG_DATABASE_URL=postgres://replaybug:replaybug@localhost:5544/replaybug
# Host-side mapped port for local Postgres (container listens on 5432 internally).
REPLAYBUG_POSTGRES_PORT=5544
REPLAYBUG_POSTGRES_USER=replaybug
REPLAYBUG_POSTGRES_PASSWORD=replaybug
REPLAYBUG_POSTGRES_DB=replaybug

# --- Release artifact storage (local filesystem; Block 7) ---
# Root directory for uploaded source maps + minified assets. API and worker
# share this directory (API writes, worker reads). Defaults to
# ~/.replaybug/artifacts when unset (outside the repo; never commit blobs).
# Containers use /var/lib/replaybug/artifacts on the replaybug_artifacts
# volume (see docs/self-hosting.md). Must be an absolute path outside repo
# source trees; the API fails fast on unsafe values.
# REPLAYBUG_ARTIFACT_DIR=/var/lib/replaybug/artifacts
# Per-file upload cap in bytes (default 26214400 = 25 MiB).
# REPLAYBUG_ARTIFACT_MAX_FILE_BYTES=26214400

# --- Demo mode (public read-only synthetic demo; not yet implemented) ---
REPLAYBUG_DEMO_MODE=false

# --- Optional local Ollama analysis (disabled by default; must not break startup) ---
# REPLAYBUG_OLLAMA_URL=http://localhost:11434
# REPLAYBUG_OLLAMA_MODEL=llama3.1
# REPLAYBUG_OLLAMA_TIMEOUT_MS=30000

# --- Authentication (Better Auth, email/password, PG persistence) ---
# Required: at least 32 characters. Use a long random string in production.
# This placeholder is for local development only; generate a real secret for any shared env.
REPLAYBUG_AUTH_SECRET=local-dev-secret-0123456789abcdef0123456789
# Trusted dashboard origin(s) for CORS + Better Auth (comma-separated). Defaults to REPLAYBUG_WEB_URL.
REPLAYBUG_TRUSTED_ORIGINS=http://localhost:3000

# --- Ingest limits ---
# Maximum events per batch request (default: 50, per spec)
REPLAYBUG_INGEST_MAX_BATCH_EVENTS=50
# Maximum request body size in bytes (default: 524288 = 512 KB)
REPLAYBUG_INGEST_MAX_BODY_BYTES=524288
# Maximum individual event size in bytes (default: 131072 = 128 KB)
REPLAYBUG_INGEST_MAX_EVENT_BYTES=131072
# Ingest rate limit: requests per minute per project/key (default: 60)
REPLAYBUG_INGEST_RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Ingest rate limit: events per minute per project/key (default: 1000)
REPLAYBUG_INGEST_RATE_LIMIT_EVENTS_PER_MINUTE=1000

# --- User identity HMAC secret ---
# Required for deriving project-scoped anonymous user hashes from setUser({id}).
# Must be at least 32 characters. Use a long random string in production.
# Generate with: openssl rand -hex 32
REPLAYBUG_USER_HMAC_SECRET=local-dev-hmac-secret-0123456789abcdef0123456789ab

# --- Worker (async event processing) ---
# pg-boss schema. pg-boss owns and migrates every table inside it (version 42
# in pg-boss 12.33.0); ReplayBug never writes those tables directly.
REPLAYBUG_PGBOSS_SCHEMA=pgboss
# Concurrent process-event workers per process. Bounds: 1-64. Default: 2
REPLAYBUG_WORKER_CONCURRENCY=2
# Outbox rows claimed per dispatch transaction. Bounds: 1-1000. Default: 100
REPLAYBUG_OUTBOX_BATCH_SIZE=100
# Delay between outbox dispatch passes, ms. Bounds: 100-60000. Default: 1000
REPLAYBUG_OUTBOX_POLL_MS=1000
# Delay between outbox reconciliation passes, ms. Bounds: 1000-3600000. Default: 60000
REPLAYBUG_OUTBOX_RECONCILE_MS=60000
# pg-boss retries per process-event job. Bounds: 0-10. Default: 4
# (retry delay 1s, exponential backoff, max 60s)
REPLAYBUG_JOB_RETRY_LIMIT=4
# pg-boss worker poll interval, ms. Bounds: 500-60000 (500 is pg-boss's minimum). Default: 500
REPLAYBUG_JOB_POLL_MS=500