{
  "name": "@replaybug/api",
  "version": "0.1.0",
  "private": true,
  "description": "ReplayBug Fastify API (foundation: health probes and service metadata only)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "tsx ../../scripts/run-isolated-vitest.ts api"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@replaybug/artifacts": "workspace:*",
    "@replaybug/contracts": "workspace:*",
    "@replaybug/db": "workspace:*",
    "@replaybug/observability": "workspace:*",
    "@replaybug/reproducer": "workspace:*",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "pg": "^8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@replaybug/config": "workspace:*",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
