{
  "name": "@replaybug/demo",
  "version": "0.1.0",
  "private": true,
  "description": "ReplayBug deliberately-buggy demo app shell (foundation: smoke screen only, no bug scenarios yet)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint src e2e playwright.config.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@replaybug/demo: unit tests live in the SDK/API packages\"",
    "test:e2e": "node e2e/seed.mjs && playwright test"
  },
  "dependencies": {
    "@replaybug/sdk": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@replaybug/config": "workspace:*",
    "@replaybug/db": "workspace:*",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^15.0.0",
    "pg": "^8.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
