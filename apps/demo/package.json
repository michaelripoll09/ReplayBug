{
  "name": "@replaybug/demo",
  "version": "0.1.0",
  "private": true,
  "description": "ReplayBug deliberately buggy demo application",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint src e2e e2e-worker playwright.config.ts playwright.worker.config.ts playwright.shared.ts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/seed.mjs && playwright test --config=playwright.config.ts && node e2e/seed.mjs && playwright test --config=playwright.worker.config.ts"
  },
  "dependencies": {
    "@replaybug/sdk": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@replaybug/config": "workspace:*",
    "@replaybug/db": "workspace:*",
    "@replaybug/reproducer": "workspace:*",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "^15.0.0",
    "pg": "^8.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
