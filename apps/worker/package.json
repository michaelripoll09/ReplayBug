{
  "name": "@replaybug/worker",
  "version": "0.1.0",
  "private": true,
  "description": "ReplayBug background worker (foundation: lifecycle and structure only, no functional jobs yet)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@replaybug/db": "workspace:*",
    "@replaybug/observability": "workspace:*",
    "pg-boss": "12.33.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@replaybug/config": "workspace:*",
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
