{
  "name": "replaybug",
  "version": "0.1.0",
  "private": true,
  "description": "Developer observability for reproducible bugs",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @replaybug/db db:migrate",
    "db:seed": "tsx scripts/seed-dev.ts",
    "api:generate": "turbo run api:generate --filter=@replaybug/api-client",
    "api:check": "pnpm api:generate && git diff --exit-code -- packages/api-client/openapi/openapi.json packages/api-client/src/schema.d.ts",
    "sdk:size": "node scripts/sdk-size.mjs",
    "worker:latency": "tsx scripts/worker-latency-smoke.ts",
    "verify:generated-test": "tsx scripts/verify-generated-test.ts",
    "test:sdk": "pnpm --filter @replaybug/sdk test",
    "test:e2e": "pnpm --filter @replaybug/web test:e2e && pnpm --filter @replaybug/demo test:e2e",
    "test:isolation": "tsx scripts/test-parallel-integration-isolation.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
