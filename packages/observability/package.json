{
  "name": "@replaybug/observability",
  "version": "0.1.0",
  "description": "Structured Pino logging helpers shared by ReplayBug services",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist",
    "dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch --out-dir dist",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@replaybug/config": "workspace:*",
    "@types/node": "24.13.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
