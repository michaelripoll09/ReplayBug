{
  "name": "@replaybug/sdk",
  "version": "0.1.0",
  "description": "ReplayBug browser SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist",
    "dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch --out-dir dist",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "tsup src/index.ts --format esm --dts --sourcemap --clean --out-dir dist-size && gzip -c dist-size/index.js | wc -c && wc -c dist-size/index.js"
  },
  "dependencies": {
    "@replaybug/contracts": "workspace:*"
  },
  "devDependencies": {
    "@replaybug/config": "workspace:*",
    "@types/node": "24.13.6",
    "esbuild": "0.27.7",
    "happy-dom": "^20.14.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
