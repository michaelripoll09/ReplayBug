{
  "name": "@replaybug/ui",
  "version": "0.1.0",
  "description": "Shared design-system primitives for ReplayBug, compatible with shadcn/ui",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --out-dir dist --external react --external react-dom",
    "dev": "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch --out-dir dist --external react --external react-dom",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@replaybug/config": "workspace:*",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
